# ==========================================
# DailySkill - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env or secrets to version control.
# ==========================================

# Application Settings
PROJECT_NAME="DailySkill"
ENVIRONMENT="development"
DEBUG=true

# API Server Settings
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
API_V1_PREFIX="/api/v1"

# Security & CORS
# In production, set to comma-separated explicit allowed origins without wildcards
ALLOWED_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"

# Database Configuration (PostgreSQL - Phase 3)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_this_password"
POSTGRES_DB="dailyskill_db"

# Frontend Configuration
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
